# Copie este arquivo para .streamlit/secrets.toml para rodar LOCALMENTE.
# NUNCA commite o secrets.toml real — ele já está no .gitignore.
# Em produção (Streamlit Community Cloud), cole estes valores direto
# no painel do app: Settings → Secrets.

GEMINI_API_KEY = "cole-sua-chave-nova-aqui"
SUPABASE_DB_URL = "postgresql://usuario:senha@host:5432/postgres"
